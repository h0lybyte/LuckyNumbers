# Copy to .env and fill in. .env is gitignored; never commit real values.
# Push them to GitHub Actions with:  python3 tools/ln.py secrets --dry-run   (then without --dry-run)

# Unity account used by CI (ideally a dedicated build account)
UNITY_EMAIL=
UNITY_PASSWORD=
# Path to the Personal license file (Unity Hub > Licenses > Add > personal license)
UNITY_LICENSE_FILE="/Library/Application Support/Unity/Unity_lic.ulf"

# itch.io: API key from https://itch.io/user/settings/api-keys
BUTLER_API_KEY=
# itch.io "user/game-slug" (not secret: stored as a repository variable)
ITCH_TARGET=
