# proto-file: luckynumbers/v1/title.proto
# proto-message: luckynumbers.v1.TitleScreen

title: "Lucky Numbers"
start_prompt: "Drag to look around - scroll to zoom"
loading_prompt: "Loading..."
next: GAME_SCENE_INTRO
prompt_pulse_seconds: 1.6

menu { label: "Play" action: MENU_ACTION_PLAY }
menu { label: "Settings" action: MENU_ACTION_SETTINGS }

settings {
  title: "Settings"
  body: "Coming soon."
  back_label: "Back"
}

backdrop {
  camera {
    target: "home"
    distance: 6
    min_distance: 3
    max_distance: 14
    yaw_degrees: 20
    pitch_degrees: 8
    min_pitch_degrees: -60
    max_pitch_degrees: 60
    drag_degrees_per_screen: 200
    glide: 0.92
    zoom_step: 0.12
    frame_offset { x: -1.6 y: 0.2 }
    field_of_view_degrees: 45
  }

  stars {
    space_color { r: 0.01 g: 0.01 b: 0.03 a: 1 }
    nebula_color_a { r: 0.25 g: 0.08 b: 0.35 a: 1 }
    nebula_color_b { r: 0.05 g: 0.15 b: 0.35 a: 1 }
    nebula_intensity: 0.35
    nebula_scale: 1.2
    star_density: 140
    star_brightness: 1.2
    twinkle_speed: 2
    drift { x: 0.003 y: 0 }
    seed: 7
  }

  # The sun at the centre: first star = light source for every planet; planets orbit it.
  bodies {
    id: "sun"
    position { x: 0 y: 0 z: 0 }
    scale: 9
    star {
      core_color { r: 1 g: 0.78 b: 0.42 a: 1 }
      corona_color { r: 1 g: 0.55 b: 0.2 a: 1 }
      light_color { r: 1 g: 0.95 b: 0.85 a: 1 }
      intensity: 1.6
      corona_size: 1.8
      corona_power: 5
      corona_intensity: 1.8
      noise_scale: 3
      boil_speed: 0.05
    }
  }

  # Home planet: colours of Ikkemcwood's planet shader, original noise look.
  bodies {
    id: "home"
    position { x: 0 y: 0 z: 0 }
    orbit { around: "sun" radius: 48 period_seconds: 900 phase: 0.41 eccentricity: 0.05 inclination_degrees: 17 node_degrees: 0 }
    scale: 2.4
    planet {
      planet_color { r: 1 g: 0.34 b: 0 a: 1 }
      atmosphere_color { r: 0.41 g: 0.6 b: 1 a: 1 }
      light_color { r: 1 g: 1 b: 1 a: 1 }
      atmosphere_thickness: 0.08
      rotation_speed: 0.01
      light_intensity: 0.9
      shadow_intensity: 1
      noise_offset { x: 0 y: 0 z: 0 }
      noise_scale: 1.6
      noise_remap: 0
      atmosphere_intensity: 1.4
      atmosphere_power: 2.5
      terminator_softness: 0.15
      axial_tilt_degrees: -12
    }
  }

  # Grey moon circling the home planet.
  bodies {
    id: "moon"
    position { x: 0 y: 0 z: 0 }
    orbit { around: "home" radius: 2.6 period_seconds: 45 phase: 0.15 inclination_degrees: 8 }
    scale: 0.6
    planet {
      planet_color { r: 0.6 g: 0.6 b: 0.65 a: 1 }
      atmosphere_color { r: 0.7 g: 0.7 b: 0.8 a: 1 }
      light_color { r: 1 g: 1 b: 1 a: 1 }
      atmosphere_thickness: 0.04
      rotation_speed: 0.02
      light_intensity: 0.6
      shadow_intensity: 1
      noise_offset { x: 13 y: 5 z: 2 }
      noise_scale: 2.2
      noise_remap: 1
      atmosphere_intensity: 0.5
      atmosphere_power: 4
      terminator_softness: 0.15
      axial_tilt_degrees: 8
    }
  }

  # Ice world, further out.
  bodies {
    id: "ice"
    position { x: 0 y: 0 z: 0 }
    orbit { around: "sun" radius: 72 period_seconds: 2400 phase: 0.47 eccentricity: 0.12 inclination_degrees: -6 node_degrees: 40 }
    scale: 1.6
    planet {
      planet_color { r: 0.3 g: 0.75 b: 1 a: 1 }
      atmosphere_color { r: 0.8 g: 0.95 b: 1 a: 1 }
      light_color { r: 1 g: 1 b: 1 a: 1 }
      atmosphere_thickness: 0.1
      rotation_speed: 0.008
      light_intensity: 0.8
      shadow_intensity: 1
      noise_offset { x: 41 y: 17 z: 9 }
      noise_scale: 1.6
      noise_remap: 1
      atmosphere_intensity: 1.2
      atmosphere_power: 2.5
      terminator_softness: 0.15
      axial_tilt_degrees: 20
    }
  }

  # Purple giant, outermost.
  bodies {
    id: "giant"
    position { x: 0 y: 0 z: 0 }
    orbit { around: "sun" radius: 115 period_seconds: 5200 phase: 0.3 eccentricity: 0.06 inclination_degrees: 4 node_degrees: 120 }
    scale: 6
    planet {
      planet_color { r: 0.55 g: 0.2 b: 0.85 a: 1 }
      atmosphere_color { r: 0.9 g: 0.5 b: 1 a: 1 }
      light_color { r: 1 g: 1 b: 1 a: 1 }
      atmosphere_thickness: 0.12
      rotation_speed: 0.004
      light_intensity: 0.7
      shadow_intensity: 1
      noise_offset { x: 77 y: 3 z: 31 }
      noise_scale: 1.1
      noise_remap: 1
      atmosphere_intensity: 1.0
      atmosphere_power: 2
      terminator_softness: 0.15
      axial_tilt_degrees: -25
    }
  }
}
