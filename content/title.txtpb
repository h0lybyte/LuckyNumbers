# proto-file: luckynumbers/v1/title.proto
# proto-message: luckynumbers.v1.TitleScreen

title: "Lucky Numbers"
start_prompt: "Drag to look around - scroll to zoom"
loading_prompt: "Loading..."
next: GAME_SCENE_STATION
prompt_pulse_seconds: 1.6

menu { label: "Play" action: MENU_ACTION_PLAY }
menu { label: "Settings" action: MENU_ACTION_SETTINGS }
menu { label: "Credits" action: MENU_ACTION_CREDITS }

# After character creation: pick your fighter's skin (A/D or the arrows), then Launch. Placeholder numbers;
# tune with a look at the title (space units, the title camera's scale).
hangar {
  ship_length: 1.5
  distance: 0   # 0: framed like the planet's chase camera, so it's the size you fly it at
  drop: -0.1
  spin_degrees_per_second: 24
  tilt_degrees: 18
  enter_seconds: 0.6
}

# The dice that create the universe: faces -> lucky number -> generated solar system.
dice {
  roll_label: "Roll"
  roll_seconds: 1.2
  seed_format: "Lucky number {0}"
  # Four d20s. Each face is scaled into its aspect's range (a 20 on moons is "the most moons", not 20
  # moons), and every die also feeds the lucky number, the seed behind everything else.
  dice { id: "red" name: "Star" role: DIE_ROLE_STAR sides: 20 color { r: 0.85 g: 0.2 b: 0.25 a: 1 } initial_face: 20
         tooltip: "Decides the star: low rolls give a cool red dwarf, high rolls a hot blue giant. Also feeds the seed of the universe." }
  dice { id: "white" name: "Worlds" role: DIE_ROLE_WORLDS sides: 20 color { r: 0.95 g: 0.95 b: 0.95 a: 1 } initial_face: 20
         tooltip: "Decides how many planets orbit the star: 3 on a low roll, up to 6 on a high one. Also feeds the seed of the universe." }
  dice { id: "blue" name: "Moons" role: DIE_ROLE_MOONS sides: 20 color { r: 0.25 g: 0.55 b: 0.95 a: 1 } initial_face: 20
         tooltip: "Decides the number of moons: low rolls leave most planets bare, high rolls give most of them up to 3. Also feeds the seed of the universe." }
  dice { id: "gold" name: "Luck" role: DIE_ROLE_LUCK sides: 20 color { r: 0.95 g: 0.75 b: 0.2 a: 1 } initial_face: 20
         tooltip: "Your luck: more galaxies in the sky, and up to +3 on every relic roll. Also feeds the seed of the universe." }
}

# Play: UI fades, camera pushes toward home, then the intro continues from that exact view.
play_transition_seconds: 1.4
play_push_in: 0.3
# Continue (a filled save slot): watch your universe form again first.
continue_seconds: 1.6

# The universe behind the title: see content/space/.
backdrop_ref: "space/systems/home"
