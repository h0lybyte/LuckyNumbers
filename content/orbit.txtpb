# proto-file: luckynumbers/v1/orbit.proto
# proto-message: luckynumbers.v1.OrbitScene
# Outside the station: launched from the Docking Bay's console, fly round your station and dock again.
# Flies like the Flight School (planet.txtpb's landing.hover and the skin's stats). Placeholder numbers.

title: "OUTSIDE THE STATION"
hint: "W/S thrust - A/D strafe - Space/C up, down - Q/E roll (Shift: barrel roll) - Shift boost - X brake - click, then mouse to aim\nFly slowly into the docking beacon at the bay, then E to dock"
touch_hint: "Left stick: thrust and strafe - right stick: aim - Lift / Down - Roll ◀ ▶ - Boost - Brake\nFly slowly into the docking beacon at the bay, then Use to dock"
dock_prompt: "E: dock"
slow_prompt: "Too fast to dock - brake (X)"

dock_offset: 0.8     # ship lengths off the bay's outer wall
dock_radius: 0.6
dock_speed: 0.18     # of top speed
start_distance: 2.5

hull_height: 9       # m before scaling: two storeys, the roof and the deck under them
range: 40

chase_distance: 1.45
chase_height: 0.42
readout_seconds: 0.15

# Feel: shake (degrees, ship lengths, fade a second), boost widens the view (degrees), dust motes for speed.
shake_angle: 2.5
shake_offset: 0.05
shake_decay: 1.4
fov_kick: 7
dust: 140

# Alive: traffic crossing far off, debris tumbling round the hull, blinking lights, a turning radar mast; the
# station turns slowly in its orbit and the planet shifts a little as you fly (parallax).
life {
  traffic: 2
  traffic_distance: 14     # ship lengths past the hull at the nearest
  traffic_speed: 90        # m/s
  traffic_seconds: 14
  debris: 40
  debris_radius: 14        # ship lengths deep round the hull
  debris_size: 0.18        # ship lengths at most
  debris_spin: 25
  blink_seconds: 1.6
  spin: 0.35               # degrees a second
  parallax: 0.04           # of the planet's diameter, at the edge of range
  radar_spin: 30
}
