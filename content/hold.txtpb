# proto-file: luckynumbers/v1/hold.proto
# proto-message: luckynumbers.v1.HoldConfig
# Dwarven holds: the cell grid, its textures, and how the endless mines are dug.

cell_size: 2
storey_height: 3
chunk_cells: 8
textures_ref: "holds/textures/delven"

# The deep: regions of 32 x 32 cells, two storeys each.
region_cells: 32
region_levels: 2
mines_ref: "holds/mines/deep"

# What lives and lies in the deep: relic caches, creatures.
life_ref: "holds/life/default"
# The top of the hold: the gate, the great hall and its rooms (region y 1 over x, z 0).
hall_ref: "holds/hall/default"
# Depth seals, drop shafts, collapses, falling.
depth_ref: "holds/depth/default"
# Locked doors + keys, portcullises + levers in the mines.
puzzles_ref: "holds/puzzles/default"

# Warm lantern light baked into the vertex colours; ambient keeps unlit stone just readable.
lantern_radius: 9
lantern_r: 1
lantern_g: 0.72
lantern_b: 0.42
ambient: 0.18

# Climbing shafts.
climb_speed: 2.2
