# proto-file: luckynumbers/v1/planet.proto
# proto-message: luckynumbers.v1.PlanetScene
# The crash site. Ground colours, sky and sun come from the planet you crashed on.

backdrop_ref: "space/systems/home"

# Endless ground: 5 x 5 chunks of 48 m follow you (haze hides the far edge).
# The terrain's shape comes from the universe (its generator's ground profile, e.g. space/grounds/rolling).
chunk_size: 48
chunk_resolution: 33
view_chunks: 3
# The horizon: 192 m chunks out to ~860 m, so from the air you see land to the edge of the haze.
far_chunk_scale: 4
far_resolution: 24
far_view_chunks: 4

walk_speed: 4.5
sprint_speed: 8
jump_speed: 5
gravity: 14
eye_height: 1.7
look_degrees_per_pixel: 0.12

bob_amount: 0.045
bob_frequency: 1.9
sway: 0.06
# Movement feel: no instant starts and stops, a little steering in the air, a short ramp into a run.
ground_accel: 38
ground_decel: 28
air_accel: 7
sprint_ramp_seconds: 0.35
# Camera life, all scaled by camera_motion (0 = still camera; kept subtle for motion sickness).
camera_motion: 1
bob_shape: 0.35
strafe_roll_degrees: 1.4
turn_roll_degrees: 0.6
step_roll_degrees: 0.25
# Landing: 1.2 cm of dip per m/s of fall (a hop: ~3 cm, a long drop: capped at 14 cm), springing back.
land_dip_per_speed: 0.012
land_dip_max: 0.14
jump_dip: 0.025
dip_spring_hz: 2.4
dip_damping: 0.55
breath_amount: 0.006
breath_rate: 0.28
sprint_fov_kick: 4
# Arms: the idle clip barely moves (4 degrees), so add breathing, a stride swing and finger fidgets.
arm_breath_degrees: 2.5
arm_swing_degrees: 7
finger_fidget_degrees: 9

# Arm clips from the rig ("{side}" = L/R).
idle_clip: "relax"
sprint_clip: "guard_idle"
throw_clip: "jab.{side}"
# Body feel: running pumps the swing, arms rise in the air, hands shake for a while after the crash.
sprint_pump: 1.8
air_raise_degrees: 14
crash_tremor_degrees: 0.8
tremor_seconds: 10

# Hands: rig bone map, touching nearby surfaces, IK self-test.
hands_ref: "hands/rig"
# Reach out to touch things you look at within this distance of your eyes (metres).
touch_distance: 1.4
debug_reach: false
# debug_spawn { x: 0.9 y: 0 z: 0.1 }   # in front of the standing stone, facing it

# Pebbles to pick up (E), drop (E) or throw (click). You crouch for ones on the ground.
pebbles: 10
pebble_size: 0.11
grab_distance: 2.6
crouch_depth: 0.85
throw_speed: 13

wake_seconds: 3.2
# Said as you come to (the controls hint follows).
wake_lines { speaker: "You" text: "Uhh... how did I live through that?!" duration_seconds: 3.5 chars_per_second: 28 }
wake_lines_delay: 0.8
# The museum freighter: big next to you (you walk beside an 80 m hull).
wreck_distance: 60
wreck_length: 80

haze: 0.6

# Boulders (seeded, in the ground's colours); the first sits beside where you wake.
boulders: 14
boulder_spread: 90
boulder_size_min: 1.2
boulder_size_max: 3.5
sun_elevation_degrees: 38
hint: "Click to look around - WASD to move - Shift to run - Space to jump - E to pick up, click to throw - M for the map"
touch_hint: "Left stick to move - right stick to look - Run - Jump - Use to pick up, Fire to throw - Map"

# The map (M): this planet as a smooth hex globe, 10 * 14^2 + 2 = 1962 cells (12 of them pentagons), in your
# real universe: the roll's sky, your star (lighting it) and home's moons. Opens from straight above your tile.
map {
  frequency: 14
  gap: 0.06
  noise_scale: 1.6
  octaves: 5
  sea_level: 0.45
  walk_radius_metres: 3000
  crash_color { r: 1 g: 0.45 b: 0.15 a: 1 }
  pin_color { r: 1 g: 1 b: 1 a: 1 }
  ship_color { r: 0.3 g: 0.9 b: 1 a: 1 }
  grout { r: 0.05 g: 0.05 b: 0.08 a: 1 }
  distance: 3.2
  zoom_min: 1.4
  zoom_max: 8
  drag_degrees_per_pixel: 0.25
  zoom_from: 1.06
  open_seconds: 1.6
  close_seconds: 0.8
  hint: "White: you - cyan: ship - orange: wreck - drag to turn - scroll to zoom - M to close"
  touch_hint: "White: you - cyan: ship - orange: wreck - drag to turn - Close map when you're done"
}

# Arrival: you fly your own fighter in and land it near the wreck. Fully piloted: mouse pitches and yaws,
# A/D roll, W/S throttle, Shift boost, Space lift thrusters. Touch down slow and level, or crash and retry.
landing {
  ship_length: 24      # your fighter, nose to tail (about 13 of you)
  start_altitude: 110
  start_distance: 260
  start_speed: 30
  gravity: 9.8
  thrust: 22
  boost: 2
  lift: 16
  drag: 0.35
  throttle_per_second: 0.6
  turn_degrees_per_pixel: 0.08
  roll_degrees_per_second: 90
  turn_damping: 4
  roll_return_degrees_per_second: 25
  max_touchdown_vertical: 4
  max_touchdown_horizontal: 7
  max_touchdown_tilt: 18
  wing_lift: 0.011      # level flight at ~30 m/s
  grip: 1.5
  chase_distance: 1.45   # ship lengths behind: the fighter fills more of the screen
  chase_height: 0.42
  # Boarding: E beside your landed ship boards it; fly anywhere and land where you like. Above orbit_altitude
  # E breaks orbit, back to the station; climbing fades out at ceiling x orbit_altitude.
  orbit_altitude: 260
  ceiling: 1.6
  board_prompt: "E: board your ship"
  board_distance: 4
  takeoff_hint: "Space to lift off - fly anywhere, land with C - climb above 260 m and press E to go back to the station"
  touch_takeoff_hint: "Lift to rise off the ground - fly anywhere, land with Down - climb above 260 m and press Use to go back to the station"
  leave_prompt: "E: break orbit and fly back to the station"
  hint: "Mouse aim - W/S thrust - A/D strafe - Q/E roll (Shift: barrel roll) - Space/C up/down - Shift boost - X brake. Stop over the green pad, hold C to land."
  touch_hint: "Left stick: thrust and strafe - right stick: aim - Lift / Down - Roll ◀ ▶ - Boost - Brake. Stop over the green pad, hold Down to land."
  # Six-axis controls with flight assist: aim and travel independent, released keys ease out, gravity
  # cancelled; near the ground descents ease and the ship levels itself. (Off: the flight model below.)
  hover {
    enabled: true
    max_speed: 32
    reverse_speed: 10
    strafe_speed: 10
    boost: 1.8
    accel: 10
    brake: 16
    climb_speed: 9
    descend_speed: 10
    vertical_accel: 14
    turn_rate: 90
    turn_smoothing: 6
    flare_height: 12
    touchdown_speed: 1.4
    clearance: 4
    lean_degrees: 0
    roll_rate: 110
    hard_brake: 28
    level_height: 14
    level_rate: 40
    barrel_roll_seconds: 0.6   # Shift+Q / Shift+E: a full roll that way, and a dodge sideways
    barrel_roll_distance: 30   # m sideways over the roll (the fighter is 24 m long)
    barrel_roll_dodge: 6       # m/s sideways drift it leaves you with (the assist eases it out)
    barrel_roll_cooldown: 0.8
    barrel_roll_fuel: 1.5
  }
  # Flight assist: W/S set a speed the ship holds (air brakes slow it); Space hovers it down under control.
  assist {
    max_speed: 50
    boost_speed: 1.6
    brake: 14
    speed_gain: 1.2
    hover_descent: 1.6
    max_descent: 10
    descent_per_metre: 0.12
    hover_gain: 2.5
    hover_drift_damping: 0.9
    hover_level_degrees_per_second: 45
    low_altitude: 30
    low_level_factor: 3
    max_turn_rate: 70
    max_pitch: 35
    bank_per_turn: 0.45
    max_bank: 35
    pad_min_distance: 60   # clear of the 80 m hull (40 m each way from its centre) and your wings
    pad_max_distance: 80
    speed_fov: 14
    camera_bank: 0.3
    cushion_height: 5
  }
  # Feel (looks only, shared with the Flight School and outside the station): camera lag, lead into turns and
  # roll, speed widening the view, engine rumble, the hull banking and bobbing; the landing approach camera.
  feel {
    follow_seconds: 0.18     # the camera springs after its spot; the lag grows with speed
    look_ahead: 0.35         # ship lengths it aims into a turn at full turn rate
    look_ahead_rate: 4
    roll_lag: 8              # its up eases after the ship's
    roll_follow: 0.3         # level cameras: share of the ship's roll the view takes
    speed_fov: 5             # degrees wider at top speed (the planet keeps assist.speed_fov)
    rumble_angle: 0.35       # degrees, boosting / thrusting hard
    rumble_offset: 0.004     # ship lengths
    rumble_frequency: 22
    bank_per_yaw: 0.18       # degrees of roll per degree/s of yaw (90 deg/s: 16 degrees)
    strafe_bank: 10          # degrees at full strafe
    max_bank: 24
    bank_rate: 5
    bob: 0.012               # ship lengths, hovering or slow
    bob_seconds: 3.4
    bob_degrees: 0.8
    bob_speed: 0.25          # of top speed: faster, no bob
    approach_altitude: 30    # m: low and slow, the camera rises to show the ground
    approach_height: 0.35
  }
  landed_text: "Landed."
  crashed_text: "Too hard. Try again."
  landed_lines { speaker: "You" text: "Down in one piece. Now, where's that cargo?" duration_seconds: 3.5 chars_per_second: 30 }
}

# The hold's gate (only in universes with holds): 40-80 m from the site's middle, away from the wreck.
gate {
  distance_min: 45
  distance_max: 75
  width: 16
  height: 13
  depth: 14
  door_width: 4.4
  door_height: 6.5
  steps: 5
  step_rise: 0.22
  step_depth: 1.1
  pad_radius: 16
  prompt_distance: 4
  walk_in_depth: 1.2
  prompt: "E  enter the hold"
  lantern_r: 1
  lantern_g: 0.62
  lantern_b: 0.3
  lantern_intensity: 6
  lantern_range: 14
}
