# proto-file: luckynumbers/v1/planet.proto
# proto-message: luckynumbers.v1.PlanetScene
# The crash site. Ground colours, sky and sun come from the planet you crashed on.

backdrop_ref: "space/systems/home"

# Endless ground: 5 x 5 chunks of 48 m follow you (haze hides the far edge).
ground_height: 7
ground_noise_scale: 0.018
chunk_size: 48
chunk_resolution: 33
view_chunks: 3
surface_noise_scale: 0.12

walk_speed: 4.5
sprint_speed: 8
jump_speed: 5
gravity: 14
eye_height: 1.7
look_degrees_per_pixel: 0.12

bob_amount: 0.045
bob_frequency: 1.9
sway: 0.06
# Arms: the idle clip barely moves (4 degrees), so add breathing, a stride swing and finger fidgets.
arm_breath_degrees: 2.5
arm_swing_degrees: 7
finger_fidget_degrees: 9

# Arm clips from the rig ("{side}" = L/R).
idle_clip: "relax"
sprint_clip: "guard_idle"
throw_clip: "jab.{side}"
# Body feel: running pumps the swing, arms rise in the air, hands shake for a while after the crash.
sprint_pump: 1.8
air_raise_degrees: 14
crash_tremor_degrees: 0.8
tremor_seconds: 10

# Hands: rig bone map, touching nearby surfaces, IK self-test.
hands_ref: "hands/rig"
# Reach out to touch things you look at within this distance of your eyes (metres).
touch_distance: 1.4
debug_reach: false
# debug_spawn { x: 0.9 y: 0 z: 0.1 }   # in front of the standing stone, facing it

# Pebbles to pick up (E), drop (E) or throw (click). You crouch for ones on the ground.
pebbles: 10
pebble_size: 0.11
grab_distance: 2.6
crouch_depth: 0.85
throw_speed: 13

wake_seconds: 3.2
# Said as you come to (the controls hint follows).
wake_lines { speaker: "You" text: "Uhh... how did I live through that?!" duration_seconds: 3.5 chars_per_second: 28 }
wake_lines_delay: 0.8
wreck_distance: 26
wreck_length: 30

haze: 0.6

# Boulders (seeded, in the ground's colours); the first sits beside where you wake.
boulders: 14
boulder_spread: 45
boulder_size_min: 1.2
boulder_size_max: 3.5
sun_elevation_degrees: 38
hint: "Click to look around - WASD to move - Shift to run - Space to jump - E to pick up, click to throw - M for the map"

# The map (M): this planet as a smooth hex globe, 10 * 14^2 + 2 = 1962 cells (12 of them pentagons), in your
# real universe: the roll's sky, your star (lighting it) and home's moons. Opens from straight above your tile.
map {
  frequency: 14
  gap: 0.06
  noise_scale: 1.6
  octaves: 5
  sea_level: 0.45
  walk_radius_metres: 3000
  crash_color { r: 1 g: 0.45 b: 0.15 a: 1 }
  pin_color { r: 1 g: 1 b: 1 a: 1 }
  grout { r: 0.05 g: 0.05 b: 0.08 a: 1 }
  distance: 3.2
  zoom_min: 1.4
  zoom_max: 8
  drag_degrees_per_pixel: 0.25
  zoom_from: 1.06
  open_seconds: 1.6
  close_seconds: 0.8
  hint: "Drag to turn - scroll to zoom - M to close"
}

# Arrival: you fly your own fighter in and land it near the wreck. Fully piloted: mouse pitches and yaws,
# A/D roll, W/S throttle, Shift boost, Space lift thrusters. Touch down slow and level, or crash and retry.
landing {
  ship_length: 9
  start_altitude: 110
  start_distance: 260
  start_speed: 30
  gravity: 9.8
  thrust: 22
  boost: 2
  lift: 16
  drag: 0.35
  throttle_per_second: 0.6
  turn_degrees_per_pixel: 0.08
  roll_degrees_per_second: 90
  turn_damping: 4
  roll_return_degrees_per_second: 25
  max_touchdown_vertical: 4
  max_touchdown_horizontal: 7
  max_touchdown_tilt: 18
  wing_lift: 0.011      # level flight at ~30 m/s
  grip: 1.5
  chase_distance: 2.2
  chase_height: 0.7
  hint: "Mouse: pitch and turn - A/D roll - W/S throttle - Shift boost - Space lift. Land slow and level near the wreck."
  landed_text: "Landed."
  crashed_text: "Too hard. Try again."
  landed_lines { speaker: "You" text: "Down in one piece. Now, where's that cargo?" duration_seconds: 3.5 chars_per_second: 30 }
}
