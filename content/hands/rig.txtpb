# proto-file: luckynumbers/v1/hands.proto
# proto-message: luckynumbers.v1.HandRig
# PSX First Person Arms (DrillImpact): bone map. Mapped from arms_rig.glb: 52 joints, all 18 clips bake the
# arm and finger bones (Blender's IK is pre-solved), and also key handIK/elbowIK (where each hand is meant to be).
# Arm reach: upper arm 0.322 m + forearm 0.237 m = 0.56 m.

sides: ["L", "R"]   # left hand first (decides which side of each hand is the palm)

arm {
  shoulder: "shoulder.{side}"
  upper: "upper_arm.{side}"
  lower: "forearm.{side}"
  hand: "hand.{side}"
  target: "handIK.{side}"   # parented to the rig root, so it can sit anywhere
  pole: "elbowIK.{side}"    # behind/outside the elbow
}

# The thumb has no palm bone of its own (palm.01 is the index's), so its base keeps the rig's angle.
fingers { name: "thumb"                         joints: ["thumb.01.{side}", "thumb.02.{side}", "thumb.03.{side}"] }
fingers { name: "index"  palm: "palm.01.{side}" joints: ["f_index.01.{side}", "f_index.02.{side}", "f_index.03.{side}"] }
fingers { name: "middle" palm: "palm.02.{side}" joints: ["f_middle.01.{side}", "f_middle.02.{side}", "f_middle.03.{side}"] }
fingers { name: "ring"   palm: "palm.03.{side}" joints: ["f_ring.01.{side}", "f_ring.02.{side}", "f_ring.03.{side}"] }
fingers { name: "pinky"  palm: "palm.04.{side}" joints: ["f_pinky.01.{side}", "f_pinky.02.{side}", "f_pinky.03.{side}"] }

eye: "camera"
shrug_degrees: 6   # more swings the top of the upper arm (an open end of the mesh) into view
max_reach: 0.985

# Finger poses (content/hands/poses/*), blended at pose_speed per second.
pose_refs: ["hands/poses/relaxed", "hands/poses/open", "hands/poses/flat", "hands/poses/grip", "hands/poses/fist", "hands/poses/point"]
pose_speed: 8
