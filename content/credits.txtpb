# proto-file: luckynumbers/v1/credits.proto
# proto-message: luckynumbers.v1.CreditsConfig
# Single source: the title screen's Credits panel, CREDITS.md and README.md's one-liners (`tools/ln.py gen`).

title: "Credits"
intro: "Lucky Numbers is made with the work of these people. Thank you."
back_label: "Back"

sections {
  name: "Models"
  credits {
    what: "Museum freighter (the cargo ship that crashes)"
    title: "Deep Space Science Survey Vessel (PSX lo-fi)"
    author: "Vaportrash"
    license: "CC BY 4.0"
    url: "https://sketchfab.com/3d-models/deep-space-science-survey-vessel-psx-lo-fi-925a09ef43fe4675acd0a935d61dcd43"
    license_url: "https://creativecommons.org/licenses/by/4.0/"
    notes: "Changes: converted from glTF to FBX split into one part per material (tools/blender/gltf_to_fbx_by_material.py), textures downsized to 512 px, and a convex collision mesh generated from it (tools/collision/decompose.py)."
    path: "LuckyNumbers/Assets/_Project/Art/Models/CargoShip/"
  }
  credits {
    what: "Fighter ship and skins"
    title: "FREE Low Poly Space ship pack (fighter1)"
    author: "RetroVandal (formerly Psionic Games)"
    license: "Free for freeware, shareware and commercial games"
    url: "https://retrovandal.itch.io/low-poly-space-ship-pack"
    notes: "From a 2005 3D Game Resources skinning competition. Skins (named after their authors): IdolKnight (1st), Krulspeld (2nd), Kaos Kiwi (3rd), Lordshadow (4th), Wilko, Cinfa, Crono782, Cubik, Freelancer, Jodomatis, NMT3000, Psychic Parrot, Robin, Shadee, Snaz, Thor and Psionic."
    path: "LuckyNumbers/Assets/_Project/Art/Models/Fighter/README-psionic.txt"
  }
  credits {
    what: "Water Amulet (Zhang Heng's relic)"
    title: "Amulet"
    author: "Mierenttt"
    license: "CC BY 3.0"
    url: "https://blendswap.com/blend/15782"
    license_url: "https://creativecommons.org/licenses/by/3.0/"
    notes: "Changes: exported low-poly (chain subdivision off), modifiers baked, recoloured with the relic shader (tools/blender/export_relic.py)."
    path: "LuckyNumbers/Assets/_Project/Art/Models/Relics/LICENSE-blendswap-80554.html"
  }
  credits {
    what: "Roman Vase (Pliny the Elder's relic)"
    title: "ROMAN VASE"
    author: "RenderX"
    license: "CC BY 4.0"
    url: "https://sketchfab.com/3d-models/roman-vase-e63cb75682d144cab9e7f88343efff2c"
    license_url: "https://creativecommons.org/licenses/by/4.0/"
    notes: "Changes: split into one part per material, decimated from 86k to about 4k triangles, textures downsized to 512 px and painted through the relic shader (tools/blender/export_relic_parts.py)."
    path: "LuckyNumbers/Assets/_Project/Art/Models/Relics/LICENSE-roman-vase.txt"
  }
  credits {
    what: "Aztec Block (Nezahualcoyotl's relic)"
    title: "aztec block a"
    author: "RenderX"
    license: "CC BY 4.0"
    url: "https://sketchfab.com/3d-models/aztec-block-a-415b2d7d208a4e73a63ba1b3bd682269"
    license_url: "https://creativecommons.org/licenses/by/4.0/"
    notes: "Changes: stood upright (its showcase tilt cleared), extra UV layer dropped, texture downsized to 512 px and painted through the relic shader (tools/blender/export_relic_parts.py)."
    path: "LuckyNumbers/Assets/_Project/Art/Models/Relics/LICENSE-aztec-block.txt"
  }
  credits {
    what: "Aberration (the limping creature you fight on planets: rig and 17 animations)"
    title: "Aberration - PSX Horror Creature"
    author: "Rafael Martins (Blackwood Asylum: The Rake)"
    license: "Use in games allowed; the asset files may not be redistributed"
    url: "https://rafaelmarrtins.itch.io/aberration-psx-horror-creature"
    notes: "Changes: baked from the pack's glTF into one FBX (tools/blender/export_aberration.py) with root motion cut to in-place clips and each clip's stride speed recorded; the stray helper sphere dropped. The raw pack is kept out of this repo."
    path: "LuckyNumbers/Assets/_Project/Art/Characters/Aberration/"
  }
  credits {
    what: "Rattleframe (the skeleton you fight on planets: mesh, rig and skin)"
    title: "PSX Skeleton Character"
    author: "Vinrax"
    license: "Free to use in projects with credit"
    url: "https://vinrax.itch.io/psx-skeleton-character"
    notes: "Changes: baked from the pack's glTF into one FBX with animations retargeted onto its rig (tools/blender/export_skeleton.py); the stray helper sphere dropped; its own texture kept. The raw pack is kept out of this repo."
    path: "LuckyNumbers/Assets/_Project/Art/Characters/Skeleton/"
  }
  credits {
    what: "Rattleframe's animations (idle, shamble, jog, claw swipe, flinch, death), retargeted onto the skeleton"
    title: "Universal Animation Library and Universal Animation Library 2"
    author: "Quaternius"
    license: "CC0, public domain"
    url: "https://quaternius.com"
    license_url: "https://creativecommons.org/publicdomain/zero/1.0/"
    notes: "Clips used: Zombie_Idle_Loop, Zombie_Walk_Fwd_Loop, Zombie_Scratch (UAL 2); Jog_Fwd_Loop, Hit_Chest, Death01 (UAL 1). Retargeted onto Vinrax's skeleton with root motion cut to in-place clips and stride speeds recorded (tools/blender/export_skeleton.py)."
    path: "LuckyNumbers/Assets/_Project/Art/Characters/Skeleton/skeleton.fbx"
  }
  credits {
    what: "Plague Arcanist (the beaked caster you fight on planets: mesh, rig, skin and animations)"
    title: "Plague Arcanist - Retro PS1 Low Poly Magic Character"
    author: "imaginais"
    license: "Free to use, commercial projects included (the author's reply on the asset page); credit appreciated"
    url: "https://imaginais.itch.io/plague-arcanist-retro-ps1-low-poly-magic-character"
    notes: "Its animations are Mixamo's (mixamo.com takes on a Mixamo rig): fine to use in a game, not to redistribute as raw files, so only the bake is here. Changes: baked into one FBX (tools/blender/export_arcanist.py): scaled to metres, grounded, clips named and cut from the pack's takes (its death and flinch made from the ground slam and the leap's crouch), stride speeds recorded; its five textures packed into one 512 atlas. The raw pack is kept out of this repo."
    path: "LuckyNumbers/Assets/_Project/Art/Characters/Arcanist/"
  }
  credits {
    what: "Space station corridors and rooms (cream panels, leaning walls, ribs, portholes, doorways, deck)"
    title: "PSX Starship Kit Free"
    author: "heyheythere"
    license: "CC BY 4.0"
    url: "https://heyheythere.itch.io/psx-starship-kit-free"
    license_url: "https://creativecommons.org/licenses/by/4.0/"
    notes: "Changes: an alpha channel added to atlas.png as a light mask and the atlas packed with the station kit's into one (Art/Models/CombinedKit, tools/kitmask.py), RGB unchanged; room walls derived from the corridor walls with their lean cut back, corner fillers, window panes drawn as clear glass and door leaves slid in the shader, at build time."
    path: "LuckyNumbers/Assets/_Project/Art/Models/StarshipKit/LICENSE.txt"
  }
  credits {
    what: "Space station props (imported for later: cryo pods, crates, lab bench, chairs) and early room walls"
    title: "PSX Sci-Fi Station Kit Free"
    author: "heyheythere"
    license: "CC BY 4.0"
    url: "https://heyheythere.itch.io/psx-sci-fi-station-kit-free"
    license_url: "https://creativecommons.org/licenses/by/4.0/"
    notes: "Changes: an alpha channel added to atlas.png as a light mask and the atlas packed with the starship kit's into one (Art/Models/CombinedKit, tools/kitmask.py), RGB unchanged."
    path: "LuckyNumbers/Assets/_Project/Art/Models/StationKit/LICENSE.txt"
  }
  credits {
    what: "First-person arms (rig, 13 animations, skin and glove textures)"
    title: "PSX First Person Arms"
    author: "DrillImpact"
    license: "CC0, public domain"
    url: "https://drillimpact.itch.io/psx-first-person-arms-free"
  }
  credits {
    what: "Futuristic weapons: 9 guns (rifles, snipers, carbine, heavy cannon), 2 melee weapons (hammer, knife) and gun mods (scope, sight, grip, box)"
    title: "Free Futuristic Weapon Assets"
    author: "Niko-3d-models"
    license: "Free with credit"
    url: "https://niko-3d-models.itch.io/free-futuristic-weapon-assets"
    notes: "Changes: split into one FBX per weapon, modifiers baked, centred and scaled to metres (tools/blender/export_weapons.py)."
    path: "LuckyNumbers/Assets/_Project/Art/Models/Weapons/LICENSE.txt"
  }
}

