# proto-file: luckynumbers/v1/cargo.proto
# proto-message: luckynumbers.v1.CargoConfig
# The museum freighter and what it carries. The ship and museum are picked by the lucky number (Cargo.Manifest).

ship_names: ["MSV Curator", "MSV Long Memory", "MSV Patient Archive", "MSV Quiet Reliquary", "MSV Old Light"]
museums: ["Galactic Museum of Antiquities", "Hall of Lost Worlds", "Interstellar Heritage Trust", "Museum of Before"]

# The relics aboard, always all of them: item ids (named relics, each its own file in content/items/relics).
relics: ["zhang_heng_water_amulet", "pliny_roman_vase", "nezahualcoyotl_aztec_block"]

# Using a relic rolls a d20; your luck die from the title adds up to this.
luck_bonus: 3

# At the crash site: scattered round the wreck, picked up with E, used with R.
scatter_min: 10
scatter_max: 34
pickup_distance: 2.2
pickup_prompt: "E: pick up the {name}"
use_prompt: "R: use the {name}"

# Salvage jobs: walk up to the wreck and E flags it for processing (the job's done); relics are a bonus on top.
salvage_distance: 6
salvage_prompt: "E: flag the wreck for salvage"
salvage_lines { speaker: "You" text: "Salvage beacon's on. Claim's ours." duration_seconds: 2.5 chars_per_second: 40 }
salvage_lines { speaker: "Dispatch" text: "Got your tag. The wreck's flagged for processing: our crews take it from here." duration_seconds: 4 chars_per_second: 40 }
salvage_lines { speaker: "Dispatch" text: "Get back to your ship and fly up to the station to get paid. Grab any relics on the way: they sell too." duration_seconds: 5 chars_per_second: 40 }
salvaged_prompt: "Wreck flagged for processing - back to your ship"
