# proto-file: luckynumbers/v1/cargo.proto
# proto-message: luckynumbers.v1.CargoConfig
# The museum freighter and what it carries. The ship and museum are picked by the lucky number (Cargo.Manifest).

ship_names: ["MSV Curator", "MSV Long Memory", "MSV Patient Archive", "MSV Quiet Reliquary", "MSV Old Light"]
museums: ["Galactic Museum of Antiquities", "Hall of Lost Worlds", "Interstellar Heritage Trust", "Museum of Before"]

# The relics aboard, always all of them: item ids (named relics, each its own file in content/items/relics).
relics: ["zhang_heng_water_amulet", "pliny_roman_vase"]

# Using a relic rolls a d20; your luck die from the title adds up to this.
luck_bonus: 3

# At the crash site: scattered round the wreck, picked up with E, used with R.
scatter_min: 10
scatter_max: 34
pickup_distance: 2.2
pickup_prompt: "E: pick up the {name}"
use_prompt: "R: use the {name}"
