/* Lucky Numbers UI theme: every screen shares these classes.

   Look: neon HUD, matching the web overlay (TemplateData/style.css tokens).
     cyan    rgb(0, 229, 255)    system colour: edges, labels, readouts
     magenta rgb(255, 43, 214)   accent: active/pressed, section heads
     amber   rgb(255, 176, 32)   warnings
     panel   rgba(3, 10, 20, .85) dark glass
   USS has no clip-path or gradients, so panels are square with a thick cyan bar on the left. */

/* Exo 2 (OFL, see CREDITS.md); Bold/Italic are linked weight variants of this asset. */
:root {
    -unity-font-definition: url("../../Art/Fonts/Exo2/Exo2-Regular-SDF.asset");
}

.ln-screen {
    flex-grow: 1;
    align-items: center;
    padding: 64px 0 28px 0;
}

.ln-spacer {
    flex-grow: 1;
}

.ln-title {
    font-size: 72px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    color: rgb(225, 252, 255);
    /* Neon glow; the outline keeps it readable over bright sky (sun, corona). */
    text-shadow: 0 0 18px rgba(0, 229, 255, 0.6);
    -unity-text-outline-width: 0.25px;
    -unity-text-outline-color: rgba(0, 229, 255, 0.9);
}

.ln-menu {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 26px;
}

.ln-button {
    width: 220px;
    height: 56px;
    margin: 0 12px;
    font-size: 22px;
    letter-spacing: 3px;
    color: rgb(0, 229, 255);
    background-color: rgba(3, 10, 20, 0.82);
    border-width: 1px 1px 1px 4px;
    border-color: rgba(0, 229, 255, 0.45);
    border-left-color: rgb(0, 229, 255);
    border-radius: 0;
    transition-property: background-color, border-color, color, translate;
    transition-duration: 0.12s;
}

/* Hover inverts (solid cyan, dark text) so the label stays crisp. Unity's default theme styles
   .unity-button:hover:enabled / :active:enabled; match that specificity so ours wins. */
.unity-button.ln-button:hover:enabled {
    color: rgb(3, 10, 20);
    background-color: rgb(0, 229, 255);
    border-color: rgb(0, 229, 255);
    border-left-color: rgb(255, 43, 214);
    translate: 3px 0;
}

.unity-button.ln-button:active:enabled {
    color: rgb(3, 10, 20);
    background-color: rgb(255, 43, 214);
    border-color: rgb(255, 43, 214);
}

.ln-prompt {
    font-size: 18px;
    letter-spacing: 4px;
    color: rgb(170, 245, 255);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.95);
}

.ln-panel {
    position: absolute;
    left: 50%;
    top: 45%;
    width: 560px;
    height: 320px;
    translate: -50% -50%;
    padding: 24px;
    align-items: center;
    justify-content: space-around;
    background-color: rgba(3, 10, 20, 0.93);
    border-width: 1px 1px 1px 4px;
    border-color: rgba(0, 229, 255, 0.4);
    border-left-color: rgb(0, 229, 255);
    border-radius: 0;
}

/* Credits: a taller panel with a scrolling list. */
.ln-panel--tall {
    top: 50%;
    background-color: rgba(2, 7, 14, 0.98);
    width: 760px;
    max-width: 94%;
    height: 82%;
    justify-content: flex-start;
}

.ln-credits-intro {
    margin: 6px 0 12px 0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.ln-credits-list {
    flex-grow: 1;
    width: 100%;
    margin-bottom: 14px;
}

.ln-credit-section {
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(255, 43, 214);
    text-shadow: 0 0 6px rgba(255, 43, 214, 0.6);
    margin: 14px 0 6px 0;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 43, 214, 0.35);
}

.unity-button.ln-credit {
    margin: 0 0 10px 0;
    padding: 4px 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0 0 0 2px;
    border-color: rgba(0, 229, 255, 0);
    border-radius: 0;
    align-items: flex-start;
    -unity-text-align: upper-left;
}

/* Unity's default theme styles .unity-button:hover:enabled; match it so ours wins. */
.unity-button.ln-credit:hover:enabled {
    background-color: rgba(0, 229, 255, 0.06);
    border-color: rgb(0, 229, 255);
}

.unity-button.ln-credit:active:enabled {
    background-color: rgba(255, 43, 214, 0.2);
    border-color: rgb(255, 43, 214);
}

.ln-credit Label {
    -unity-text-align: upper-left;
}

.ln-credit-head {
    font-size: 19px;
    color: rgb(225, 252, 255);
    white-space: normal;
}

.ln-credit-detail {
    font-size: 15px;
    color: rgba(150, 215, 235, 0.75);
    white-space: normal;
}

.ln-credit-link {
    font-size: 14px;
    color: rgb(0, 229, 255);
    white-space: normal;
}

.ln-panel-title {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: rgb(0, 229, 255);
    text-shadow: 0 0 10px rgba(0, 229, 255, 0.7);
}

.ln-panel-body {
    font-size: 22px;
    color: rgba(217, 247, 255, 0.85);
}

.ln-placeholder {
    flex-grow: 1;
    font-size: 36px;
    color: rgb(225, 252, 255);
    -unity-text-align: middle-center;
}

.ln-button--small {
    width: 140px;
    height: 44px;
    margin: 10px 0 6px 0;
    font-size: 18px;
}

/* Dice panel: bottom-left. */
.ln-dice-panel {
    position: absolute;
    left: 28px;
    bottom: 24px;
    align-items: flex-start;
    padding: 12px;
    background-color: rgba(3, 10, 20, 0.6);
    border-width: 1px 1px 1px 3px;
    border-color: rgba(0, 229, 255, 0.3);
    border-left-color: rgba(0, 229, 255, 0.85);
    border-radius: 0;
}

/* Narrow panels (TitleView toggles .ln-narrow): dice under the menu, centred, instead of the corner. */
.ln-narrow .ln-dice-panel {
    position: relative;
    left: 0;
    bottom: 0;
    margin-top: 14px;
    align-items: center;
}

.ln-narrow .ln-menu {
    margin-bottom: 14px;
}

.ln-dice-row {
    flex-direction: row;
}

.ln-die {
    width: 58px;
    height: 58px;
    margin-right: 10px;
    padding: 6px;
    flex-direction: row;
    flex-wrap: wrap;
    border-radius: 11px;
    border-width: 2px;
    border-color: rgba(0, 229, 255, 0.55);
}

.ln-pip-cell {
    width: 33.33%;
    height: 33.33%;
    align-items: center;
    justify-content: center;
}

.ln-pip {
    width: 10px;
    height: 10px;
    border-radius: 5px;
}

.ln-pip--off {
    visibility: hidden;
}

.ln-die-number {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* d20 and other numbered dice: a little tighter so two digits sit well. */
.ln-die--number {
    border-radius: 8px;
}

/* d20s: drawn by DiceView (hexagon, faces); bigger, no box, the number on the centre face. */
.ln-die--d20 {
    width: 76px;
    height: 76px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ln-die--d20 .ln-die-number {
    /* Down a little: the centre face is widest below its middle. */
    padding-top: 9%;
    font-size: 17px;
    letter-spacing: -0.5px;
}

.ln-die--active {
    border-color: rgb(0, 229, 255);
}

/* What a die decides, while you hover (or tap) one: beside the dice panel with an arrow to the die (DiceView picks
   the side with room), or above it when neither side fits. Never takes clicks. */
.ln-dice-tip {
    position: absolute;
    width: 280px;
    padding: 8px 12px;
    background-color: rgba(3, 10, 20, 0.94);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.45);
}

.ln-dice-tip-text {
    font-size: 14px;
    white-space: normal;
    color: rgb(220, 248, 255);
}

.ln-dice-tip-arrow {
    position: absolute;
    width: 12px;
    height: 12px;
    rotate: 45deg;
    background-color: rgba(3, 10, 20, 0.94);
    border-color: rgba(0, 229, 255, 0.45);
}

.ln-dice-tip--right {
    left: 100%;
    margin-left: 14px;
    border-left-width: 3px;
    border-left-color: rgb(0, 229, 255);
}

/* Points left: its outer edges are the square's left and bottom. */
.ln-dice-tip--right .ln-dice-tip-arrow {
    left: -9px;
    border-left-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(0, 229, 255);
    border-bottom-color: rgb(0, 229, 255);
}

.ln-dice-tip--left {
    right: 100%;
    margin-right: 14px;
    border-right-width: 3px;
    border-right-color: rgb(0, 229, 255);
}

/* Points right: top and right edges. */
.ln-dice-tip--left .ln-dice-tip-arrow {
    right: -9px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(0, 229, 255);
    border-right-color: rgb(0, 229, 255);
}

.ln-dice-tip--above {
    left: 0;
    bottom: 100%;
    margin-bottom: 14px;
    border-bottom-width: 3px;
    border-bottom-color: rgb(0, 229, 255);
}

/* Points down: right and bottom edges. */
.ln-dice-tip--above .ln-dice-tip-arrow {
    bottom: -9px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgb(0, 229, 255);
    border-bottom-color: rgb(0, 229, 255);
}

.ln-lucky {
    font-size: 15px;
    letter-spacing: 2px;
    color: rgba(0, 229, 255, 0.9);
    text-shadow: 0 0 5px rgba(0, 229, 255, 0.5);
}

/* Intro cutscene */
.ln-intro-dice {
    position: absolute;
    left: 0;
    right: 0;
    top: 38%;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.ln-intro-dice .ln-die {
    width: 84px;
    height: 84px;
    margin: 0 9px;
    padding: 9px;
    border-radius: 16px;
}

.ln-intro-dice .ln-die--d20 {
    width: 104px;
    height: 104px;
    padding: 0;
    border-radius: 0;
}

.ln-intro-dice .ln-die--d20 .ln-die-number {
    font-size: 23px;
}

.ln-intro-dice .ln-pip {
    width: 15px;
    height: 15px;
    border-radius: 7.5px;
}

.ln-intro-dice .ln-lucky {
    margin-top: 14px;
    font-size: 20px;
}

/* Comms window: speaker tag on a cyan bar, line below. */
.ln-dialogue {
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: 9%;
    padding: 14px 22px 16px 22px;
    background-color: rgba(3, 10, 20, 0.82);
    border-width: 1px 1px 1px 4px;
    border-color: rgba(0, 229, 255, 0.4);
    border-left-color: rgb(0, 229, 255);
    border-radius: 0;
}

.ln-dialogue-speaker {
    align-self: flex-start;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(3, 10, 20);
    background-color: rgb(0, 229, 255);
    padding: 1px 10px;
    margin-bottom: 8px;
}

.ln-dialogue-line {
    font-size: 24px;
    color: rgb(225, 252, 255);
    white-space: normal;
}

.ln-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    background-color: white;
}

/* Crash site */
.ln-flash--black {
    background-color: black;
    opacity: 1;
}

.ln-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 7%;
    -unity-text-align: middle-center;
    font-size: 18px;
    letter-spacing: 3px;
    color: rgba(0, 229, 255, 0.92);
    text-shadow: 0 0 6px rgba(0, 229, 255, 0.5);
    -unity-text-outline-width: 0.3px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
}

/* Reticle: a small ring with a dot (border ring on a 14px box). */
.ln-crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    margin-top: -7px;
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.75);
    background-color: rgba(0, 0, 0, 0);
}

/* Flying in: a readout strip at the top, messages in the middle. */
.ln-flight-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ln-flight-readout {
    position: absolute;
    left: 0;
    right: 0;
    top: 4%;
    -unity-text-align: middle-center;
    font-size: 20px;
    letter-spacing: 2px;
    color: rgb(0, 229, 255);
    text-shadow: 0 0 6px rgba(0, 229, 255, 0.6);
    -unity-text-outline-width: 0.3px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
}

.ln-flight-message {
    position: absolute;
    left: 0;
    right: 0;
    top: 40%;
    -unity-text-align: middle-center;
    font-size: 44px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: rgb(255, 176, 32);
    text-shadow: 0 0 14px rgba(255, 176, 32, 0.75);
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
}

/* Planet map: controls line at the top. */
.ln-map-hint {
    top: 5%;
    bottom: auto;
}

.ln-hidden {
    display: none;
}

/* Scrollbars (credits list): thin cyan rail, no arrow buttons. */
.ln-credits-list .unity-scroller--vertical {
    width: 8px;
    border-width: 0;
    background-color: rgba(0, 229, 255, 0.06);
}

.ln-credits-list .unity-scroller__low-button,
.ln-credits-list .unity-scroller__high-button {
    display: none;
}

.ln-credits-list .unity-scroller__slider {
    margin: 0;
    width: 8px;
}

.ln-credits-list .unity-base-slider__tracker {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ln-credits-list .unity-base-slider__dragger {
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 229, 255, 0.55);
    width: 8px;
    left: 0;
}

.ln-credits-list .unity-base-slider__dragger:hover {
    background-color: rgb(0, 229, 255);
}
