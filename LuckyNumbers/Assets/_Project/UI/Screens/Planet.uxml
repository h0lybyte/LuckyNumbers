<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Crash-site overlay (content/planet.txtpb). -->
    <ui:VisualElement name="screen" class="ln-screen" picking-mode="Ignore">
        <ui:VisualElement name="flash" class="ln-flash ln-flash--black" picking-mode="Ignore" />
        <ui:Label name="hint" class="ln-hint" picking-mode="Ignore" />
        <ui:VisualElement name="crosshair" class="ln-crosshair" picking-mode="Ignore" />
        <ui:Label name="map-hint" class="ln-hint ln-map-hint ln-hidden" picking-mode="Ignore" />
        <!-- Flying in: altitude, vertical speed, speed, throttle, the wreck's distance and bearing; and a message. -->
        <ui:VisualElement name="flight-hud" class="ln-flight-hud ln-hidden" picking-mode="Ignore">
            <ui:Label name="flight-readout" class="ln-flight-readout" picking-mode="Ignore" />
            <ui:Label name="flight-message" class="ln-flight-message" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="dialogue" class="ln-dialogue ln-hidden" picking-mode="Ignore">
            <ui:Label name="speaker" class="ln-dialogue-speaker" picking-mode="Ignore" />
            <ui:Label name="line" class="ln-dialogue-line" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
