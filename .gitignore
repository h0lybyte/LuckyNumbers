# =============================================================
# Unity project lives in /LuckyNumbers
# =============================================================

# --- Unity generated folders (regenerated on open) ---
/LuckyNumbers/[Ll]ibrary/
/LuckyNumbers/[Tt]emp/
/LuckyNumbers/[Oo]bj/
/LuckyNumbers/[Bb]uild/
/LuckyNumbers/[Bb]uilds/
/LuckyNumbers/[Ll]ogs/
/LuckyNumbers/[Uu]ser[Ss]ettings/
/LuckyNumbers/[Mm]emoryCaptures/
/LuckyNumbers/[Rr]ecordings/

# Never ignore Asset meta data (required for GUID references)
!/LuckyNumbers/[Aa]ssets/**/*.meta

# Autogenerated by plugins / packages
/LuckyNumbers/[Aa]ssets/Plugins/Editor/JetBrains*
/LuckyNumbers/[Aa]ssets/AssetStoreTools*
/LuckyNumbers/[Aa]ssets/StreamingAssets/aa/
/LuckyNumbers/[Aa]ssets/StreamingAssets/aa.meta
/LuckyNumbers/[Aa]ssets/[Ss]treamingAssets/aa/*
/LuckyNumbers/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/LuckyNumbers/[Aa]ssets/SceneDependencyCache*
/LuckyNumbers/[Aa]ssets/_Recovery*
/LuckyNumbers/[Aa]ssets/TextMesh*Pro/Examples*

# Gradle / Android
.gradle/
ExportedObj/
.consulo/
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Burst debug info
/LuckyNumbers/[Ll]ibrary/BurstCache/
*_BurstDebugInformation_DoNotShip/

# --- IDE / generated solution files (Unity regenerates) ---
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
.vs/
.idea/
.vsconfig
*.DotSettings.user

# VS Code: keep shared config, drop the rest
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider
/LuckyNumbers/.idea/
*.sln.iml

# --- OS junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Misc ---
*.log
*.blend1
*.blend2
*.swp
*~
